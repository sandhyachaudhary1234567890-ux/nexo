# =============================================================================
# NEXO SERVER — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in all values before starting the server.
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development          # 'development' | 'production' | 'test'

# The URL of your frontend client (used for CORS and OAuth redirects)
CLIENT_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# MongoDB connection URI. When using docker-compose, use the service name.
# Example for Docker: mongodb://mongo:27017/nexo
MONGO_URI=mongodb://localhost:27017/nexo

# Redis connection URI. When using docker-compose, use the service name.
# Example for Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------

# Access token secret — minimum 64 characters recommended
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARACTERS_LONG

# Refresh token secret — must be DIFFERENT from JWT_SECRET, minimum 64 characters
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_STRING_AT_LEAST_64_CHARS

# Access token expiry (e.g. 15m, 1h, 24h)
JWT_EXPIRES_IN=15m

# Refresh token expiry (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# GOOGLE OAUTH 2.0
# Create credentials at: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# -----------------------------------------------------------------------------
# AI PROVIDERS
# -----------------------------------------------------------------------------

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key

# -----------------------------------------------------------------------------
# LEAD DATA PROVIDERS
# -----------------------------------------------------------------------------

# Apollo.io — https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key

# Hunter.io — https://hunter.io/api-keys
HUNTER_API_KEY=your_hunter_api_key

# Clearbit — https://dashboard.clearbit.com/api
CLEARBIT_API_KEY=your_clearbit_api_key

# -----------------------------------------------------------------------------
# EMAIL (SMTP)
# Example providers: Gmail, SendGrid, Mailgun, Postmark
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                 # 587 (STARTTLS) or 465 (SSL)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password   # Use App Password for Gmail, not your account password
SMTP_FROM="Nexo <noreply@nexo.ai>"

# -----------------------------------------------------------------------------
# BULL BOARD (Job Queue Dashboard)
# Accessible at: http://localhost:PORT/admin/queues
# -----------------------------------------------------------------------------
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin123  # Change this in production!
